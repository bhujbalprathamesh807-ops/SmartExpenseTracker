# PostgreSQL is required for both local development and production.
DEBUG=1
SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# PostgreSQL database (required everywhere)
# Example: postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
DATABASE_URL=
DATABASE_SSL_REQUIRE=1

# Payments
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
REGISTRATION_FEE=99.00
PAYMENT_DEMO_MODE=0
